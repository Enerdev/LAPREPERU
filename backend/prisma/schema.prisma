generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id                  String       @id @default(cuid())
  dni                 String       @unique
  nombres             String
  apellidos           String
  email               String
  telefono            String
  sede                String
  ciclo               String
  estado              EstadoAlumno @default(pendiente)
  fechaMatricula      DateTime     @default(now())
  pagado              Boolean      @default(false)
  monto               Float
  montoPagado         Float        @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  apellidoMaterno     String?
  apellidoPaterno     String?
  cicloDuracion       String?
  cicloInicio         String?
  cicloTurno          String?
  codigoMatricula     String?      @unique
  colegioAnioEgreso   String?
  colegioDepartamento String?
  colegioDistrito     String?
  colegioNombre       String?
  colegioProvincia    String?
  comoSeEntero        String?
  comoSeEnteroDetalle String?
  departamento        String?
  direccion           String?
  distrito            String?
  escuelaProfesional  String?
  facultad            String?
  fechaNacimiento     DateTime?
  lugarNacimiento     String?
  provincia           String?
  payments            Payment[]

  @@map("students")
}

model Payment {
  id         String     @id @default(cuid())
  studentId  String
  concepto   String
  monto      Float
  fecha      DateTime   @default(now())
  estado     EstadoPago @default(pendiente)
  sede       String
  metodoPago String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  student    Student    @relation(fields: [studentId], references: [id])

  @@map("payments")
}

model Sede {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sedes")
}

enum EstadoAlumno {
  activo
  inactivo
  pendiente
}

enum EstadoPago {
  pagado
  pendiente
  vencido
}
